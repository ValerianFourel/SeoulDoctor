# Model provider (OpenRouter preferred; Groq is the fallback)
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Required separately for text-embedding-3-small / Chroma indexing
OPENAI_API_KEY=

LLM_PROVIDER=openrouter
OPENROUTER_CHAT_MODEL=openai/gpt-oss-120b
OPENROUTER_AGENT_MODEL=openai/gpt-oss-120b
OPENROUTER_EVAL_MODEL=qwen/qwen3.8-max
LLM_REASONING_EFFORT=medium
CHAT_RATE_LIMIT_REQUESTS=12
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Groq fallback model options
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Primarily Korean Naver comment snapshot (224 MiB on first download)
ENABLE_RAW_REVIEWS=true
RAW_REVIEWS_PATH=./local_reviews_cache.parquet

# Location services
GOOGLE_MAPS_API_KEY=
KAKAO_REST_API_KEY=

# Optional dataset access
HF_TOKEN=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
